data-execution="{&quot;iopub.execute_input&quot;:&quot;2025-12-20T22:40:13.372612Z&quot;,&quot;iopub.status.busy&quot;:&quot;2025-12-20T22:40:13.372282Z&quot;,&quot;iopub.status.idle&quot;:&quot;2025-12-20T22:40:15.351203Z&quot;,&quot;shell.execute_reply&quot;:&quot;2025-12-20T22:40:15.350029Z&quot;}"
