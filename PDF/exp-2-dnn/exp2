class="sourceCode python"><code class="sourceCode python"><span id="cb56-1"><a href="#cb56-1" aria-hidden="true" tabindex="-1"></a><span class="co">&#39;&#39;&#39;from scikeras.wrappers import KerasClassifier</span></span>
