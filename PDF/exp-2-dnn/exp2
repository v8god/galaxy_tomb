<span id="cb56-87"><a href="#cb56-87" aria-hidden="true" tabindex="-1"></a><span class="cf">for</span> opt <span class="kw">in</span> optimizers:</span>
<span id="cb56-88"><a href="#cb56-88" aria-hidden="true" tabindex="-1"></a>    <span class="cf">for</span> bs <span class="kw">in</span> batch_sizes:</span>
<span id="cb56-89"><a href="#cb56-89" aria-hidden="true" tabindex="-1"></a>        <span class="cf">for</span> ep <span class="kw">in</span> epochs_list:</span>
<span id="cb56-90"><a href="#cb56-90" aria-hidden="true" tabindex="-1"></a>            <span class="bu">print</span>(<span class="ss">f&quot;Training → opt=</span><span class="sc">{</span>opt<span class="sc">}</span><span class="ss">, batch=</span><span class="sc">{</span>bs<span class="sc">}</span><span class="ss">, epochs=</span><span class="sc">{</span>ep<span class="sc">}</span><span class="ss">&quot;</span>)</span>
<span id="cb56-91"><a href="#cb56-91" aria-hidden="true" tabindex="-1"></a>            </span>
<span id="cb56-92"><a href="#cb56-92" aria-hidden="true" tabindex="-1"></a>            model <span class="op">=</span> build_model(opt)  <span class="co"># 🔥 NEW optimizer every time</span></span>
