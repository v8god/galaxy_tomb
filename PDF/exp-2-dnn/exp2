<span id="cb21-2"><a href="#cb21-2" aria-hidden="true" tabindex="-1"></a>le <span class="op">=</span> LabelEncoder()</span>
<span id="cb21-3"><a href="#cb21-3" aria-hidden="true" tabindex="-1"></a>bird_data[[<span class="st">&#39;type&#39;</span>]] <span class="op">=</span> bird_data[[<span class="st">&#39;type&#39;</span>]].<span class="bu">apply</span>(le.fit_transform)</span></code></pre></div>
